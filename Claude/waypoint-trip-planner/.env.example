# Copy to .env and fill in. Never commit .env — keys stay on the Node server.

# Required for AI planning, "make it cheaper" and chat.
ANTHROPIC_API_KEY=

# Optional: model and reasoning effort (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# PLAN_EFFORT=medium
# CHAT_EFFORT=low
# Server-side refusal fallback is on by default for supported models; set to "off" to disable.
# ANTHROPIC_FALLBACKS=on

# Optional: live ticketed events (free key at developer.ticketmaster.com).
# TICKETMASTER_API_KEY=

# Optional: identify yourself to OpenStreetMap / Overpass / NWS per their usage policies.
# CONTACT_EMAIL=you@example.com

# Optional: self-hosted services for production.
# OVERPASS_URL=https://your-overpass/api/interpreter
# ROUTING_URL=https://your-osrm-host

# Ports: API_PORT for the dev API (Vite proxies /api to it), PORT for production.
# API_PORT=8787
# PORT=8787
# AI_RATE_LIMIT=30          # AI requests per IP per 10 minutes
# FORCE_HTTPS=1             # add CSP upgrade-insecure-requests when served over TLS
